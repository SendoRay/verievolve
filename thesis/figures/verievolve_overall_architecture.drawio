        <mxCell id="innovation" value="&lt;b&gt;Key innovation:&lt;/b&gt; accuracy is a continuous, deterministic optimization signal inside the evolutionary loop—rather than a binary correctness gate or a noisy simulation estimate. The search can therefore retain precision-negotiable hardware trade-offs." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=13;fillColor=#FFF9E8;strokeColor=#D6B656;fontColor=#5D4A00;" vertex="1" parent="1"><mxGeometry x="340" y="820" width="1030" height="80" as="geometry"/></mxCell>

