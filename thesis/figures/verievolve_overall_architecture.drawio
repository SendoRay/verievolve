        <mxCell id="analytic" value="&lt;b&gt;Analytic error model&lt;/b&gt;&#xa;Integer residual / convolution calculation&#xa;or deterministic enumeration / worst-case bound&#xa;&lt;font color=&quot;#356A2D&quot;&gt;Deterministic precision; no sampling variance&lt;/font&gt;&#xa;RTL bit-true calibration" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=7;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#234F1E;" vertex="1" parent="measurement_lane"><mxGeometry x="35" y="70" width="320" height="135" as="geometry"/></mxCell>
