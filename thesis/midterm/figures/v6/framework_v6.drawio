        <mxCell id="lowering_agent" value="&lt;b&gt;RTL 实现智能体&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;在冻结契约内生成 RTL&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f5f5b;strokeWidth=1.8;fontColor=#202020;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="stage3">
          <mxGeometry x="40" y="370" width="280" height="120" as="geometry"/>
