          <mxGeometry x="820" y="30" width="380" height="880" as="geometry"/>
        </mxCell>
        <mxCell id="stage3" value="&lt;b&gt;Stage 3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;RTL 降低&lt;/font&gt;" style="swimlane;startSize=80;horizontal=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;fillColor=#595959;swimlaneFillColor=#fff4cf;strokeColor=#202020;strokeWidth=1.5;fontColor=#ffffff;fontSize=19;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1220" y="30" width="360" height="880" as="geometry"/>
        </mxCell>
        <mxCell id="stage4" value="&lt;b&gt;Stage 4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;综合与输出&lt;/font&gt;" style="swimlane;startSize=80;horizontal=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;fillColor=#595959;swimlaneFillColor=#fff4cf;strokeColor=#202020;strokeWidth=1.5;fontColor=#ffffff;fontSize=19;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1600" y="30" width="480" height="880" as="geometry"/>
        </mxCell>

        <mxCell id="task_contract" value="&lt;b&gt;任务契约&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;F　理想功能&lt;br&gt;Q　质量约束（指标 + 容差）&lt;br&gt;I　接口 + PPA 目标&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f5f5b;strokeWidth=1.8;fontColor=#202020;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="stage0">
          <mxGeometry x="30" y="140" width="270" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="initial_program" value="&lt;b&gt;初始原语程序&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;由 F 直接翻译&lt;br&gt;搜索树根节点 + 工程基线&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf2f7;strokeColor=#5f5f5b;strokeWidth=1.8;fontColor=#202020;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="stage0">
          <mxGeometry x="30" y="470" width="270" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="design_agent" value="&lt;b&gt;设计智能体（LLM）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;REWRITE：结构改写&lt;br&gt;TUNE：位宽、舍入、流水、复用&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f5f5b;strokeWidth=1.8;fontColor=#202020;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="stage1">
          <mxGeometry x="40" y="140" width="350" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="search_tree" value="&lt;b&gt;AND/OR 搜索树&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;节点 = 一份完整原语程序&lt;br&gt;OR：同一区域的备选改法&lt;br&gt;AND：必须共同实现的子区域&lt;br&gt;&lt;br&gt;&lt;b&gt;BROKEN　OPEN&lt;br&gt;FEASIBLE　VERIFIED&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dfeaf2;strokeColor=#5f5f5b;strokeWidth=1.8;fontColor=#202020;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="stage1">
          <mxGeometry x="40" y="410" width="350" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="legality_check" value="&lt;b&gt;1　合法性检查&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;类型 / 速率检查&lt;br&gt;核实声明的变换关系：&lt;br&gt;逐位等价 / 数学等价 / 近似&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f5f5b;strokeWidth=1.8;fontColor=#202020;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="stage2">
          <mxGeometry x="30" y="140" width="320" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="quality_check" value="&lt;b&gt;2　系统质量检查&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;SNR / EVM / BER&lt;br&gt;是否满足系统容差？&lt;br&gt;&lt;br&gt;已核实的逐位等价改动&lt;br&gt;直接继承父节点质量结论&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f5f5b;strokeWidth=1.8;fontColor=#202020;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="stage2">
          <mxGeometry x="30" y="450" width="320" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="frozen_contract" value="&lt;b&gt;冻结实现契约&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;接口、量化、状态&lt;br&gt;latency / II、资源承诺&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f5f5b;strokeWidth=1.8;fontColor=#202020;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="stage3">
          <mxGeometry x="40" y="130" width="280" height="150" as="geometry"/>
