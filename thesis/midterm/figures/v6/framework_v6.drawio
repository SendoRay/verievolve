        <mxCell id="stage1" value="&lt;b&gt;Stage 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;原语设计&lt;/font&gt;" style="swimlane;startSize=80;horizontal=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;fillColor=#595959;swimlaneFillColor=#eef4e4;strokeColor=#202020;strokeWidth=1.5;fontColor=#ffffff;fontSize=19;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="1">
