        <mxCell id="fidelity_check" value="&lt;b&gt;一致性检查&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;RTL ≡ 候选&lt;br&gt;逐位结果 + 事务时序&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dfeaf2;strokeColor=#5f5f5b;strokeWidth=1.8;fontColor=#202020;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="stage3">
